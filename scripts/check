#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# Bounded builds by default (CI sets two jobs): unbounded parallel links of the
# Bevy test executables with debug info can exhaust a workstation's memory.
: "${CARGO_BUILD_JOBS:=4}" "${CARGO_PROFILE_DEV_DEBUG:=0}" "${CARGO_PROFILE_TEST_DEBUG:=0}"
export CARGO_BUILD_JOBS CARGO_PROFILE_DEV_DEBUG CARGO_PROFILE_TEST_DEBUG
cargo fmt --all -- --check
cargo clippy --locked --workspace --all-targets -- -D warnings
# Only the table package has features.
cargo clippy --locked -p unfolded-tabletop --all-targets --features render -- -D warnings
cargo clippy --locked -p unfolded-tabletop --all-targets --features seat -- -D warnings
# The Bevy-free packages. Features only add dependencies, so a graph without
# Bevy under all features on all targets has none under any feature set. Each
# package is also linted alone: in a workspace build another member's features
# could supply a dependency feature that a game depending on it alone lacks.
# Every workspace member except the table package is one.
members=$(cargo tree --locked --workspace --depth 0 -e normal --prefix none --format '{p}')
mapfile -t bevy_free < <(awk 'NF && $1 != "unfolded-tabletop" {print $1}' <<<"$members" | sort -u)
for package in "${bevy_free[@]}"; do
  tree=$(cargo tree --locked -p "$package" --all-features --target all -e normal,build,dev \
    --prefix none --format '{p}')
  if grep -E '^bevy(_[a-z0-9_]+)? ' <<<"$tree"; then
    echo "error: $package reaches Bevy" >&2
    exit 1
  fi
  cargo clippy --locked -p "$package" --all-targets --all-features -- -D warnings
done
# A crate that needs only seeded randomness gets nothing else from this repository.
random_tree=$(cargo tree --locked -p unfolded-random --all-features --target all -e normal,build \
  --prefix none --format '{p}')
if [[ "$random_tree" != "unfolded-random v"* || "$random_tree" == *$'\n'* ]]; then
  printf 'error: unfolded-random has dependencies:\n%s\n' "$random_tree" >&2
  exit 1
fi
cargo test --locked --workspace
cargo test --locked -p unfolded-tabletop --features render
cargo test --locked -p unfolded-tabletop --features seat
# The vendored patch is excluded from the workspace; run its upload-memory
# regression tests with its own lockfile, as vendor/wgpu-hal/ARKHAM_PATCH.md records.
cargo test --locked --manifest-path vendor/wgpu-hal/Cargo.toml --target-dir "${CARGO_TARGET_DIR:-target}" \
  --lib --no-default-features --features vulkan vulkan::upload_memory::tests
