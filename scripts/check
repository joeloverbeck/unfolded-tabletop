#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
cargo fmt --all -- --check
cargo clippy --locked --workspace --all-targets -- -D warnings
cargo clippy --locked --workspace --all-targets --features render -- -D warnings
cargo clippy --locked --workspace --all-targets --features seat -- -D warnings
cargo test --locked --workspace
cargo test --locked --workspace --features render
cargo test --locked --workspace --features seat
